# 本机：docker compose up -d 之后用下面这行。
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/rag
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 进模型的资料字符上限（已扣 system/问题）。中转 8k 窗口先用这个，不要按 128k 塞满。
MAX_CONTEXT_CHARS=8000
# 工作记忆：最近几条；最多占窗口比例，避免闲聊挤掉资料。
HISTORY_MAX_TURNS=6
HISTORY_BUDGET_RATIO=0.3
# 工具循环上限。最后一轮禁止 retrieve。
MAX_AGENT_STEPS=4
# 混合召回。两路各取一批再融合；FINAL_K 是交给生成的证据数，不是召回条数。
BM25_K=30
DENSE_K=30
RERANK_CANDIDATES=30
FINAL_K=6
# 同一文档先封顶，不够再按名次补回。
RERANK_PER_SOURCE=3
# 空则不做 Cross-Encoder。启用前 pip install -e ".[rerank]"。
# 基线 BAAI/bge-reranker-v2-m3；对照 Qwen/Qwen3-Reranker-0.6B。分数只用于排序。
RERANK_MODEL=
RERANK_MAX_LENGTH=512
RERANK_MAX_CHARS=2000
# 设为 1 时把候选的 bm25_rank、dense_rank、rrf_rank、rerank_score、final_rank 打到日志。
RERANK_TRACE=
